rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return isAuthenticated() && 'role' in request.auth.token ? request.auth.token.role : 'customer';
    }

    function isOwner() {
      return getUserRole() == 'owner';
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isStaff() {
      return isAdmin() || isOwner();
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true; // Public read
      allow write: if isStaff(); // Only Admin/Owner write
    }

    // --- Users Collection ---
    match /users/{uid} {
      allow read: if isOwnerOf(uid) || isStaff();
      // Allow user creation on signup, and updates only if role is not modified
      allow create: if isAuthenticated() && request.auth.uid == uid && request.resource.data.role == 'customer';
      allow update: if isOwnerOf(uid) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isOwner();
      allow delete: if isOwner();
    }

    // --- Carts Collection ---
    match /carts/{uid} {
      allow read, write: if isOwnerOf(uid) || isStaff();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Customers can create orders, and read their own. Staff can do everything.
      allow create: if true; // Allows guest checkout too
      allow read: if isStaff() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isOwner();
    }

    // --- Login Logs Collection ---
    match /loginLogs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
